---
import AcademicLayout from '../layouts/AcademicLayout.astro';
import { formatNewsMonthYear, newsItems } from '../data/news';
import { withBase } from '../utils/paths';

const localLink = (href: string) => href.startsWith('/') ? withBase(href) : href;
const supabaseUrl = 'https://rxnhlmrvwmepuphpithm.supabase.co';
const supabasePublishableKey = 'sb_publishable_dW6VM2wj55-8rysyeIRubQ_s--GnMD7';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AcademicLayout title="News" description="SAIL news archive." activeNav="news">
  <main class="academic-content">
    <header class="academic-page-header">
      <p class="academic-kicker">News</p>
      <h1 class="academic-name">Lab updates.</h1>
      <p class="academic-section-intro">
        Recent papers, grants, professional service, and lab milestones.
      </p>
    </header>

    <section class="academic-section">
      <ul class="academic-news-list" data-cms-news-list>
        {newsItems.map((item) => (
          <li class="academic-news-item">
            <span class="academic-news-date">{formatNewsMonthYear(item.date)}</span>
            <span class="academic-news-text">
              {item.link ? <a href={localLink(item.link)}>{item.title}</a> : item.title}
              <span class="academic-news-label"> - {item.label}</span>
              <br />
              {item.summary}
            </span>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <script is:inline define:vars={{ supabaseUrl, supabasePublishableKey, baseUrl }}>
    window.SAIL_CMS_CONTENT_CONFIG = { supabaseUrl, supabasePublishableKey, baseUrl };
  </script>
  <script type="module" src={withBase('/scripts/cms-public-content.js')}></script>
</AcademicLayout>
