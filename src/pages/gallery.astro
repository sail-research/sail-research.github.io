---
import AcademicLayout from '../layouts/AcademicLayout.astro';
---

<AcademicLayout title="Gallery" description="SAIL gallery coming soon.">
  <main class="academic-content" data-sail-visual-page="gallery">
    <header class="academic-page-header" data-sail-native="intro">
      <p class="academic-kicker" data-sail-eyebrow>Gallery</p>
      <h1 class="academic-name" data-sail-heading>Coming soon.</h1>
      <p class="academic-section-intro" data-sail-intro>
        A curated gallery for seminars, meetings, conference moments, and lab activities is being prepared.
      </p>
    </header>
    <section class="academic-section" data-sail-native="placeholder">
      <div class="academic-card">
        <h2 data-sail-heading>Gallery coming soon</h2>
        <p data-sail-intro>Photos will be added after the lab image set is curated and approved.</p>
      </div>
    </section>
  </main>
</AcademicLayout>
