---
import AcademicLayout from '../layouts/AcademicLayout.astro';
import { site } from '../data/site';
import { formatNewsMonthYear, newsItems } from '../data/news';
import { withBase } from '../utils/paths';

const localLink = (href: string) => href.startsWith('/') ? withBase(href) : href;
const supabaseUrl = 'https://rxnhlmrvwmepuphpithm.supabase.co';
const supabasePublishableKey = 'sb_publishable_dW6VM2wj55-8rysyeIRubQ_s--GnMD7';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AcademicLayout title="Home" description={site.description} activeNav="home">
  <main class="academic-content" data-cms-page-content="home">
    <header class="academic-header" data-cms-section="home:intro">
      <div class="academic-header-grid">
        <h1 class="academic-name">{site.name}</h1>
        <p class="academic-title">{site.tagline}</p>
        <p class="academic-subtitle">{site.affiliation}</p>
        <p class="academic-meta">VinUniversity, Hanoi, Vietnam</p>
        <div class="academic-social">
          {site.socialLinks.map((link) => link.url && <a class="academic-pill" href={link.url}>{link.label}</a>)}
          <a class="academic-pill" href={`mailto:${site.email}`}>Email</a>
        </div>
      </div>

      <div class="academic-bio">
        <p data-cms-section-copy>
          Our research group is situated within <a href="https://vinuni.edu.vn/college-of-engineering-computer-science/">VinUniversity's College of Engineering and Computer Science</a>.
          We specialize in trustworthy, distributed, and efficient AI, with a core focus on developing machine
          learning systems that remain robust, private, scalable, and practical in real-world settings. Our research
          encompasses federated learning, privacy-preserving machine learning, backdoor attacks and defenses,
          communication-efficient learning, edge AI, continual learning, and resource-aware AI to enhance security,
          privacy, reliability, efficiency, and fairness.
        </p>
      </div>
    </header>

    <section class="academic-section" data-cms-section="home:news">
      <h2 class="academic-section-title" data-cms-section-heading>News</h2>
      <ul class="academic-news-list" data-cms-news-list>
        {newsItems.map((item) => (
          <li class="academic-news-item">
            <span class="academic-news-date">{formatNewsMonthYear(item.date)}</span>
            <span class="academic-news-text">
              {item.link ? <a href={localLink(item.link)}>{item.title}</a> : item.title}
              <span class="academic-news-label"> - {item.label}</span>
              <br />
              {item.summary}
            </span>
          </li>
        ))}
      </ul>
    </section>

  </main>
  <script is:inline define:vars={{ supabaseUrl, supabasePublishableKey, baseUrl }}>
    window.SAIL_CMS_CONTENT_CONFIG = { supabaseUrl, supabasePublishableKey, baseUrl };
  </script>
  <script type="module" src={withBase('/scripts/cms-public-content.js')}></script>
</AcademicLayout>
