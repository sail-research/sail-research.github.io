---
import AcademicLayout from '../layouts/AcademicLayout.astro';
import { allPublications, type Publication } from '../data/publications';

const groupByYear = (items: Publication[]) =>
  items.reduce((groups, publication) => {
    if (!groups.has(publication.year)) groups.set(publication.year, []);
    groups.get(publication.year)?.push(publication);
    return groups;
  }, new Map<number, Publication[]>());

const publicationsByYear = groupByYear(allPublications);
const firstLink = (links = []) => links[0]?.url;
const authorText = (authors: string[]) => authors.join(', ');
const linkLabel = (item: { label: string; url: string }) => {
  const label = item.label.toLowerCase();
  const url = item.url.toLowerCase();
  if (label.includes('code') || url.includes('github.com')) return 'Code';
  if (label.includes('project') || label.includes('homepage')) return 'Project';
  if (label.includes('arxiv') || url.includes('arxiv.org')) return 'Preprint';
  return 'Paper';
};
const venueWithYear = (publication: Publication) => {
  const year = String(publication.year);
  return publication.venue.includes(year) ? publication.venue : `${publication.venue} ${year}`;
};
const workshopVenue = (publication: Publication) => {
  const venue = venueWithYear(publication);
  const workshopIndex = venue.toLowerCase().indexOf(' workshop');
  return workshopIndex >= 0 ? `${venue.slice(0, workshopIndex).trim()} Workshop` : `${venue} Workshop`;
};
const venueText = (publication: Publication) => {
  if (publication.type === 'preprint') return 'preprint';
  if (publication.type === 'workshop') return workshopVenue(publication);

  const venue = venueWithYear(publication);
  if (!publication.venueMetric) return venue;

  if (publication.type === 'journal') {
    return `${venue}: Impact Factor ${publication.venueMetric.value}`;
  }

  return `${venue}: ${publication.venueMetric.value}`;
};
---

<AcademicLayout title="Publications" description="Published and preprint research from the SAIL lab." activeNav="publications">
  <main class="academic-content">
    <header class="academic-page-header">
      <p class="academic-kicker">Publications</p>
      <h1 class="academic-name">Lab published papers.</h1>
      <p class="academic-section-intro">
        A curated publication list focused on trustworthy AI, federated learning, privacy, robustness, and efficient
        machine learning. We prioritize publishing in top-tier, peer-reviewed AI/ML venues. Our recent contributions
        have been accepted at leading conferences such as CVPR, NeurIPS, ECCV, ICML, ICLR, AAAI, ACL, WWW, and WACV.
      </p>
    </header>

    <section class="academic-section">
      {[...publicationsByYear.entries()].map(([year, items]) => (
        <div class="academic-year-group">
          <div class="academic-year">{year}</div>
          <ul class="academic-publication-list">
            {items.map((publication) => {
              const link = firstLink(publication.links);
              return (
                <li class="academic-publication-item">
                  {link ? (
                    <a class="academic-publication-title" href={link}>{publication.title}</a>
                  ) : (
                    <span class="academic-publication-title">{publication.title}</span>
                  )}
                  <span class="academic-authors">{authorText(publication.authors)}</span>
                  <span class="academic-venue">{venueText(publication)}</span>
                  {publication.links && publication.links.length > 0 && (
                    <span class="academic-publication-links">
                      {publication.links.map((item) => <a href={item.url}>{linkLabel(item)}</a>)}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </section>
  </main>
</AcademicLayout>
